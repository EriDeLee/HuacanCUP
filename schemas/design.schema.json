{
  "$defs": {
    "Block": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "功能块标识，小写字母开头",
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "purpose": {
          "description": "这一块做什么，会写进原理图页名旁边和文档",
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        }
      },
      "required": [
        "id",
        "purpose"
      ],
      "title": "Block",
      "type": "object"
    },
    "Board": {
      "additionalProperties": false,
      "properties": {
        "size_mm": {
          "description": "板子宽、高",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Size Mm",
          "type": "array"
        },
        "layers": {
          "default": 2,
          "enum": [
            2,
            4
          ],
          "title": "Layers",
          "type": "integer"
        },
        "mount_holes": {
          "anyOf": [
            {
              "pattern": "^M(2|2\\.5|3)x(2|4)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "安装孔，如 M3x4 = 四角各一个 M3 孔；x2 = 左上、右下两个",
          "title": "Mount Holes"
        },
        "edge_connectors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EdgeConnector"
          },
          "title": "Edge Connectors",
          "type": "array"
        },
        "net_classes": {
          "additionalProperties": {
            "$ref": "#/$defs/NetClass"
          },
          "description": "自定义网络类；default 也可以在这里改",
          "title": "Net Classes",
          "type": "object"
        }
      },
      "required": [
        "size_mm"
      ],
      "title": "Board",
      "type": "object"
    },
    "EdgeConnector": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "side": {
          "enum": [
            "left",
            "right"
          ],
          "title": "Side",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "side"
      ],
      "title": "EdgeConnector",
      "type": "object"
    },
    "Net": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "网络名，不含空格和斜杠",
          "minLength": 1,
          "pattern": "^[^\\s/]+$",
          "title": "Name",
          "type": "string"
        },
        "class": {
          "default": "default",
          "description": "网络类：default 或 board.net_classes 里的名字（决定线宽、间距）",
          "title": "Class",
          "type": "string"
        },
        "nodes": {
          "description": "[[位号, 引脚编号], ...]",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "minItems": 1,
          "title": "Nodes",
          "type": "array"
        },
        "external_supply": {
          "default": false,
          "description": "这个网络的电由板外经连接器送进来。原理图上只给这样的网络放 PWR_FLAG（ADR-0008）；没标的电源网络若没有电源输出来驱动，ERC 照样报错",
          "title": "External Supply",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "nodes"
      ],
      "title": "Net",
      "type": "object"
    },
    "NetClass": {
      "additionalProperties": false,
      "properties": {
        "track_mm": {
          "description": "线宽",
          "exclusiveMinimum": 0,
          "title": "Track Mm",
          "type": "number"
        },
        "clearance_mm": {
          "description": "与其他铜的最小间距",
          "exclusiveMinimum": 0,
          "title": "Clearance Mm",
          "type": "number"
        },
        "via_diameter_mm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "过孔外径；不填用 KiCad 默认",
          "title": "Via Diameter Mm"
        },
        "via_drill_mm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "过孔钻孔；不填用 KiCad 默认",
          "title": "Via Drill Mm"
        }
      },
      "required": [
        "track_mm",
        "clearance_mm"
      ],
      "title": "NetClass",
      "type": "object"
    },
    "Part": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "description": "位号，如 R1、U3",
          "pattern": "^[A-Z]+[0-9]+$",
          "title": "Ref",
          "type": "string"
        },
        "block": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "所属功能块（blocks[].id）",
          "title": "Block"
        },
        "symbol": {
          "description": "KiCad 符号，库名:符号名",
          "pattern": "^[^:\\s]+:[^:\\s]+$",
          "title": "Symbol",
          "type": "string"
        },
        "footprint": {
          "description": "KiCad 封装，库名:封装名",
          "pattern": "^[^:\\s]+:[^:\\s]+$",
          "title": "Footprint",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "mpn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "厂商料号",
          "title": "Mpn"
        },
        "lcsc": {
          "anyOf": [
            {
              "pattern": "^C[0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "立创商城编号",
          "title": "Lcsc"
        },
        "source": {
          "anyOf": [
            {
              "enum": [
                "inventory",
                "catalog"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "inventory = 用户库存；catalog = 元器件目录",
          "title": "Source"
        },
        "spice": {
          "anyOf": [
            {
              "$ref": "#/$defs/Spice"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ratings": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "额定值，如 {'vds_max': 55, 'id_max': 49}，单位用国际单位制",
          "title": "Ratings",
          "type": "object"
        },
        "ratings_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/RatingsSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ratings 的出处"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "hub",
                "connector",
                "passive"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "画原理图时的角色（ADR-0013）。hub = 主芯片，自成一团，其余元件沿它的引脚排开；connector = 连接器，画在页边、引脚朝里；passive = 两脚元件，串在引脚链上。不填则按引脚数推断：两个引脚的是 passive，其余是 hub",
          "title": "Role"
        },
        "anchor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "画原理图时贴在哪个元件旁边（位号）。用于不在任何引脚链上的元件，如电源和地之间的去耦电容；不填则贴在同一功能块里第一个和它共用网络的主芯片旁边",
          "title": "Anchor"
        }
      },
      "required": [
        "ref",
        "symbol",
        "footprint",
        "value"
      ],
      "title": "Part",
      "type": "object"
    },
    "RatingsSource": {
      "additionalProperties": false,
      "properties": {
        "doc_id": {
          "description": "数据手册标识（检索库里的文档 id）",
          "minLength": 1,
          "title": "Doc Id",
          "type": "string"
        },
        "page": {
          "description": "页码，从 1 开始",
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        }
      },
      "required": [
        "doc_id",
        "page"
      ],
      "title": "RatingsSource",
      "type": "object"
    },
    "Spice": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "description": "SPICE 模型或子电路名",
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "lib": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "模型文件（相对仓库根目录，如 models/irfz44n.lib）；ngspice 原生元件留空",
          "title": "Lib"
        },
        "pin_map": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "符号引脚编号 → 模型端子名，如 {'1': 'G', '2': 'D', '3': 'S'}",
          "title": "Pin Map",
          "type": "object"
        }
      },
      "required": [
        "model"
      ],
      "title": "Spice",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "spec_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "对应的冻结 spec 的 sha256",
      "title": "Spec Sha256"
    },
    "blocks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Block"
      },
      "title": "Blocks",
      "type": "array"
    },
    "parts": {
      "items": {
        "$ref": "#/$defs/Part"
      },
      "minItems": 1,
      "title": "Parts",
      "type": "array"
    },
    "nets": {
      "items": {
        "$ref": "#/$defs/Net"
      },
      "minItems": 1,
      "title": "Nets",
      "type": "array"
    },
    "board": {
      "$ref": "#/$defs/Board"
    },
    "notes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    }
  },
  "required": [
    "parts",
    "nets",
    "board"
  ],
  "title": "Design",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design.schema.json"
}
