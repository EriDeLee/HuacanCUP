{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trace.schema.json",
  "title": "runs/<id>/trace.jsonl 中的一行事件",
  "description": "M0：tool_call、step。M1：snapshot（存了一版设计）、patch（应用 JSON Patch，成败都记）、gate（检查报告）。M2：可选的 branch（哪一路）。llm_call / human / cost 在后续里程碑加入。网页回放完全依赖这个文件。",
  "type": "object",
  "required": ["ts", "run_id", "seq", "type"],
  "properties": {
    "ts": {"type": "string", "format": "date-time"},
    "run_id": {"type": "string", "minLength": 1},
    "seq": {"type": "integer", "minimum": 0},
    "type": {"enum": ["tool_call", "step", "snapshot", "patch", "gate"]},
    "branch": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "这条记录属于第几路（ADR-0016）；共享阶段不写或写 null。M2 只有 G2 和摆放写它，其余留给 M3"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "tool_call"}}},
      "then": {
        "required": ["tool", "argv", "cwd", "exit_code", "timed_out", "duration_s", "stdout_path", "stderr_path"],
        "properties": {
          "tool": {"type": "string"},
          "argv": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "cwd": {"type": "string"},
          "exit_code": {"type": ["integer", "null"]},
          "timed_out": {"type": "boolean"},
          "termination": {"enum": ["none", "graceful", "forced"]},
          "duration_s": {"type": "number", "minimum": 0},
          "stdout_path": {"type": ["string", "null"]},
          "stderr_path": {"type": ["string", "null"]},
          "stdout_tail": {"type": "string"},
          "stderr_tail": {"type": "string"}
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "step"}}},
      "then": {
        "required": ["name", "status"],
        "properties": {
          "name": {"type": "string"},
          "status": {"enum": ["start", "ok", "fail"]},
          "detail": {"type": "object"}
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "snapshot"}}},
      "then": {
        "required": ["iteration", "by", "path"],
        "properties": {
          "iteration": {"type": "integer", "minimum": 0},
          "by": {"type": "string", "description": "谁存的：智能体名、human 或 example"},
          "path": {"type": "string", "description": "相对运行目录，如 iterations/00/design.json"}
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "patch"}}},
      "then": {
        "required": ["by", "ok", "ops", "errors"],
        "properties": {
          "by": {"type": "string"},
          "ok": {"type": "boolean"},
          "ops": {"type": "integer", "minimum": 0},
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "message"],
              "properties": {
                "kind": {"enum": ["patch", "design"]},
                "message": {"type": "string"},
                "op_index": {"type": ["integer", "null"]},
                "loc": {"type": "string"}
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "gate"}}},
      "then": {
        "required": ["gate", "passed", "counts", "iteration", "path"],
        "properties": {
          "gate": {"type": "string"},
          "passed": {"type": "boolean"},
          "counts": {"type": "object", "additionalProperties": {"type": "integer"}},
          "iteration": {"type": "integer", "minimum": 0},
          "path": {"type": "string"}
        }
      }
    }
  ]
}
